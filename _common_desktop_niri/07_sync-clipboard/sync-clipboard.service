[Unit]
Description=Bridge clipboard content between the Wayland and X11 (XWayland/spice-vdagent) clipboards
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/sync-clipboard --daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
